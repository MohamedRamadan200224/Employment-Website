# Copy to .env and fill in real values. Never commit .env.
# Database connection (defaults match the previous hardcoded values,
# so an existing local setup keeps working without a .env file).
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=iaproject
DB_PORT=3306
# Port the API listens on (default 3306 — the MySQL port; a follow-up
# should move this to its own port, e.g. 5000).
PORT=3306
# The only origin allowed to call this API (CORS). Change when the
# frontend is deployed somewhere other than localhost:3000.
FRONTEND_URL=http://localhost:3000
