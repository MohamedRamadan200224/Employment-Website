# Copy to .env and fill in real values. Never commit .env.
# Database connection (defaults match the previous hardcoded values,
# so an existing local setup keeps working without a .env file).
DB_HOST=localhost
DB_USER=root
# The real password of your own MySQL/MariaDB user. If your local MySQL
# root has no password, leave this empty. Never put a real password in
# this .example file — only in your local BackEnd/.env.
DB_PASSWORD=your_mysql_password_here
DB_NAME=iaproject
DB_PORT=3306
# Port the API listens on (default 3306 — the MySQL port; set this to a
# free port such as 5000 when MySQL already uses 3306, otherwise the API
# fails to start with EADDRINUSE. If you change it, set the same port in
# FrontEnd/.env as REACT_APP_API_URL).
PORT=3306
# The only origin allowed to call this API (CORS). Change when the
# frontend is deployed somewhere other than localhost:3000.
FRONTEND_URL=http://localhost:3000
