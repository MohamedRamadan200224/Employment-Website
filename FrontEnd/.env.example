# Base URL of the backend API. Every page reads this value instead
# of hardcoding localhost — set it when the backend runs anywhere
# other than http://localhost:3306.
REACT_APP_API_URL=http://localhost:3306
# Show real jobs from the backend database instead of the hardcoded
# sample jobs on the Home page: set to 'false' (or leave unset).
# NOTE: this only takes effect after FrontEnd/src/pages/Home/Home.js
# stops forcing mock data — change its line
# `const useMockData = true;` back to
# `const useMockData = process.env.REACT_APP_USE_MOCK_DATA === 'true';`.
# Until then the Home page always shows the 6 sample jobs.
REACT_APP_USE_MOCK_DATA=false
